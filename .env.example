# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values, then run `npm run config`.
# On Vercel / Netlify set these same keys as project Environment Variables.
# ---------------------------------------------------------------------------

# --- FRONTEND (safe to expose — protected by Row Level Security) -------------
# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase anon / publishable key (Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# The values below are used ONLY by Supabase (Edge Function secrets + CI cron).
# They are NEVER bundled into the frontend. Set them with:
#   supabase secrets set KEY=value
# ---------------------------------------------------------------------------

# Which live provider the sync-fixtures Edge Function should call.
# One of: mock | api-football | football-data
FOOTBALL_API_PROVIDER=mock

# API key for the chosen provider:
#   api-football  -> https://www.api-football.com/  (header x-apisports-key)
#   football-data -> https://www.football-data.org/ (header X-Auth-Token)
FOOTBALL_API_KEY=

# Season year for the competition (api-football needs this, e.g. 2025)
FOOTBALL_API_SEASON=2025

# Shared secret required in the `x-cron-secret` header to trigger sync-fixtures.
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# Auto-injected by Supabase into Edge Functions — only needed for local `supabase functions serve`
SUPABASE_SERVICE_ROLE_KEY=
