# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Used by `npm run config` (frontend) and
# `npm run sync` (fixtures). On Vercel/Netlify only the two FRONTEND vars are
# needed; the sync vars go in GitHub Actions secrets instead.
# ---------------------------------------------------------------------------

# --- FRONTEND (safe to expose — protected by Row Level Security) ------------
SUPABASE_URL=https://YOUR_REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon JWT
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx


# --- FIXTURE SYNC (server-side only — never bundled into the frontend) ------
# Secret key (sb_secret_...) or a legacy service_role JWT. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# uefa | football-data | api-football | mock
#   uefa   -> official UEFA feed, NO API KEY NEEDED (recommended)
#   mock   -> self-advancing demo fixtures (needs seed.sql)
FOOTBALL_API_PROVIDER=uefa

# Season. uefa: the year the final is played (2026/27 -> 2027).
#         api-football: the start year (2026/27 -> 2026).
FOOTBALL_API_SEASON=2027

# Only needed for football-data / api-football:
#   football-data.org token  -> https://www.football-data.org/client/register
#   API-Football key         -> https://dashboard.api-football.com/register
FOOTBALL_API_KEY=


# --- Only if you use the Edge Function instead of `npm run sync` ------------
# Shared secret for the x-cron-secret header.  openssl rand -hex 32
CRON_SECRET=
